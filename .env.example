OPENAI_API_KEY=
GEMINI_API_KEY=
NEXT_PUBLIC_A2A_ORCHESTRATION_BASE_URL=
AINSPACE_STORAGE_REDIS_URL=
AINSPACE_BLOB_READ_WRITE_TOKEN=

ADMIN_DASHBOARD_URL= # for cors header
ADMIN_API_SECRET= # shared secret for admin dashboard API bypass

# Agent movement settings
# Radius for spawn-centered movement mode (in tiles, default: 3)
NEXT_PUBLIC_SPAWN_RADIUS=3

# Report API (optional, falls back to NEXT_PUBLIC_A2A_ORCHESTRATION_BASE_URL)
DEMO_REPORT_URL=

# New backend (NestJS JWT auth) — server-only, called by BFF (not exposed to browser)
# Empty = backend auth disabled (BFF /api/backend-auth/* returns 503)
BACKEND_BASE_URL=
BACKEND_CLIENT_ID=ainspace
# Browser-DIRECT auth (verify/refresh) needs the backend origin + client id in the
# browser bundle (cookie-based refresh; httpOnly cookie is backend-origin scoped).
# Usually the same value as BACKEND_BASE_URL. Origin must be in the backend's
# EXTERNAL_ORIGIN_ALLOWLIST or CORS will 403.
NEXT_PUBLIC_BACKEND_BASE_URL=
NEXT_PUBLIC_BACKEND_CLIENT_ID=ainspace
# Workspace UUID ainspace is bound to (backend CLIENT_WORKSPACE_MAP value).
# Required: BFF injects it into /dm and /agents calls. Empty = thread APIs 500.
BACKEND_WORKSPACE_ID=

# /api/ain/* 세션 검증 (AIN integration). 이 라우트군은 backend JWT 를 원본으로 전달하지 않으므로
# 서명을 여기서 직접 검사한다. backend(ainteams/backend)의 JWT_SIGNING_KEY 와 같은 값(32자 이상, HS256).
# 비어 있으면 BACKEND_BASE_URL 의 GET /auth/me introspection 으로 대신 검증하고, 둘 다 없으면 라우트는
# 503 temporary_failure(app_session_verifier_missing) — 검증 없이 열리지 않는다. 서버 전용.
BACKEND_JWT_SIGNING_KEY=
# 기본 a2a-backend / client-access (backend token.ts 의 issuer·audience). 다른 backend 를 붙일 때만.
BACKEND_JWT_ISSUER=
BACKEND_JWT_AUDIENCE=

# Exhibition kiosk (EPIC18) — set only on the kiosk project, empty elsewhere.
# Its presence is the single switch for kiosk mode: the BFF auto-logs-in the
# shared service account and the client bootstraps a wallet-less session.
BACKEND_KIOSK_PRIVATE_KEY=   # server-only EOA key, signs challenge locally

# Report dual-write (EPIC21) — server-only, injected by the BFF (/api/report-ingest),
# NEVER exposed to the browser (do NOT prefix with NEXT_PUBLIC_). ainspace mirrors the
# conversation turns it conducts to the a2a-orchestrator ingest endpoint. Leave BOTH
# empty to disable dual-write entirely (silent no-op; chat unaffected).
ORCHESTRATOR_URL=   # e.g. https://orchestrator.example.com (report ingest base)
INGEST_TOKEN=       # server-only Bearer token for POST /api/ingest/conversation
# AIN integration (adapter-spec 작업 09) — "나에게 공유된 파일/에이전트" 진입점.
# 기본 off. 서버 라우트(/api/ain/*)는 AIN_INTEGRATION_ENABLED, 클라이언트 진입점은
# NEXT_PUBLIC_AIN_INTEGRATION_ENABLED 를 본다 (서버는 둘 중 하나만 켜도 열린다).
AIN_INTEGRATION_ENABLED=false
NEXT_PUBLIC_AIN_INTEGRATION_ENABLED=false
AINDRIVE_URL=https://aindrive.ainetwork.ai
AINIZE_URL=https://ainize.ai
# auth_required 의 actionUrl (기본 {NEXT_PUBLIC_URL 또는 요청 오리진}/api/ain/aindrive/connect — 이 제품의 연결 시작)
AINDRIVE_CONNECT_URL=
# aindrive 계정 연결(OAuth code + PKCE, public client). aindrive 에 등록한 client_id 와
# redirect_uri = {NEXT_PUBLIC_URL}/api/ain/aindrive/callback. 없으면 연결을 시작하지 않는다(503).
AINDRIVE_OAUTH_CLIENT_ID=
# 저장 토큰 봉인 키(AES-256-GCM, HKDF 로 파생). 32자 이상의 무작위 문자열. 없으면 연결·저장하지 않는다(평문 저장 없음).
# 바꾸면 기존 연결은 열리지 않아 사용자가 다시 연결해야 한다.
AINDRIVE_TOKEN_KEY=
# 배포 단위 aindrive 계정 토큰(aind_aat_…) — 사용자별 연결(봉인 저장, Redis ain:aindrive_account:<userId>)이
# 없을 때의 fallback. 키오스크처럼 계정이 하나인 배포에서만. 서버 전용, 브라우저에 절대 노출 금지.
AINDRIVE_ACCOUNT_TOKEN=
# 2단계(adapter-invoke-spec): 공유 에이전트 호출 /api/ain/invoke 와 변경 이벤트 /api/ain/events.
# 위임(ain-rdlg+jwt)은 AIN SSO 에 first-party 클라이언트 자격(client_secret_basic)으로 요청한다. 서버 전용.
AIN_SSO_ISSUER=https://auth.comcom.ai
AIN_SSO_CLIENT_ID=
AIN_SSO_CLIENT_SECRET=
# auth_required(세션 증명 없음)의 actionUrl (기본 {AIN_SSO_ISSUER}/)
AIN_SSO_CONNECT_URL=
# 세션 증명 = 사용자의 AIN SSO ID 토큰. Space 는 AIN SSO 로그인이 없어 운영에서는 항상 없음(공통 항목 B 해당 없음). 이 파일은 **개발 전용**
# fallback(NODE_ENV=production 이면 무시) — 절대 다른 토큰(backend JWT·Google)을 대신 쓰지 않는다.
AIN_SESSION_PROOF_FILE=
